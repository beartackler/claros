{
    "name": "Claros",
    "tags": [
        "claros",
        "hackathon"
    ],
    "conversation_config": {
        "agent": {
            "first_message": "",
            "language": "en",
            "dynamic_variables": {
                "dynamic_variable_placeholders": {
                    "mode": "capture",
                    "user_name": "there",
                    "workflow_name": "unknown workflow",
                    "session_id": "none"
                }
            },
            "prompt": {
                "prompt": "You are Claros, a curious, patient apprentice (with experts) and tutor (with learners) who watches screen work.\nSession mode: {{mode}}. User: {{user_name}}. Workflow: {{workflow_name}}.\n\nHard rules (never break them):\n1. Markers. If the latest user message contains ⟦ask:ID⟧ or ⟦intervene:ID⟧, say EXACTLY the text supplied with that marker (text after a \"|\" inside the marker, or the most recent context update for that ID). Say nothing else. If no text was supplied, call skip_turn.\n2. Silence while working. If the user is narrating their own work, thinking aloud, reading the screen, or talking to someone else, and is not addressing Claros, call skip_turn. When unsure, call skip_turn.\n3. One question at a time, at most 15 words. No preamble, no lists, no summaries unless asked.\n4. Never invent rules, thresholds, policies, approvers, or numbers. If you do not know, say so and offer to ask an expert (request_expert).\n5. Always reply in the language the user is speaking. If it changes, call language_detection.\n6. Learn mode: give hints and ask the learner to predict the next step before telling them. Explain only what the confirmed map says.\n7. \"Off the record\" means call go_off_record and stay silent until \"back on record\" (go_on_record).\n8. Call end_call only when the user clearly says they are done.\nTone: warm, curious, brief. You may use one gentle audio tag like [curious] or [warm], never more.",
                "llm": "gemini-3.5-flash-lite",
                "temperature": 0.3,
                "max_tokens": 200,
                "tool_ids": [
                    "tool_5801m41whm6ge6bsfghjj8sqbysh",
                    "tool_6301m41whm6he4xve0vx3hyttqs7",
                    "tool_4801m41whm6jfeya9jdv11sfpe5p",
                    "tool_0401m41whm6kef7bj22dkdat9cdm",
                    "tool_5401m41whm6mepgt3jcvsr2ja1ff",
                    "tool_4101m41whm6nfx6b9ttskbk2pfv4"
                ],
                "built_in_tools": {
                    "skip_turn": {
                        "type": "system",
                        "name": "skip_turn",
                        "description": "Stay silent this turn. Use whenever the user is narrating their work, thinking aloud or not addressing Claros.",
                        "params": {
                            "system_tool_type": "skip_turn"
                        }
                    },
                    "language_detection": {
                        "type": "system",
                        "name": "language_detection",
                        "description": "",
                        "params": {
                            "system_tool_type": "language_detection",
                            "only_at_conversation_start": false
                        }
                    },
                    "end_call": {
                        "type": "system",
                        "name": "end_call",
                        "description": "End the session only when the user clearly says they are finished.",
                        "params": {
                            "system_tool_type": "end_call"
                        }
                    }
                },
                "ignore_default_personality": true,
                "enable_parallel_tool_calls": false,
                "backup_llm_config": {
                    "preference": "default"
                }
            }
        },
        "language_presets": {
            "de": {
                "overrides": {
                    "agent": {
                        "language": "de"
                    }
                },
                "first_message_translation": null
            },
            "fr": {
                "overrides": {
                    "agent": {
                        "language": "fr"
                    }
                },
                "first_message_translation": null
            },
            "es": {
                "overrides": {
                    "agent": {
                        "language": "es"
                    }
                },
                "first_message_translation": null
            },
            "ru": {
                "overrides": {
                    "agent": {
                        "language": "ru"
                    }
                },
                "first_message_translation": null
            }
        },
        "tts": {
            "model_id": "eleven_v3_conversational",
            "voice_id": "XrExE9yKIg1WjnnlVkGX",
            "expressive_mode": true,
            "suggested_audio_tags": [
                {
                    "tag": "curious",
                    "description": "When asking the expert why."
                },
                {
                    "tag": "warm",
                    "description": "When encouraging a learner."
                }
            ],
            "stability": 0.5,
            "speed": 1.0,
            "similarity_boost": 0.8
        },
        "asr": {
            "provider": "scribe_realtime",
            "quality": "high",
            "keywords": [
                "Claros",
                "off the record",
                "strike that",
                "ERPNext",
                "invoice",
                "capex"
            ]
        },
        "turn": {
            "turn_eagerness": "patient",
            "turn_timeout": 30,
            "silence_end_call_timeout": -1,
            "soft_timeout_config": {
                "timeout_seconds": -1,
                "use_llm_generated_message": false
            }
        },
        "conversation": {
            "text_only": false,
            "max_duration_seconds": 3600
        }
    },
    "platform_settings": {
        "overrides": {
            "custom_llm_extra_body": true,
            "conversation_config_override": {
                "agent": {
                    "first_message": true,
                    "language": true,
                    "prompt": {
                        "prompt": true
                    }
                },
                "tts": {
                    "voice_id": true
                },
                "asr": {
                    "keywords": true
                }
            }
        },
        "privacy": {
            "record_voice": true,
            "retention_days": 7
        }
    }
}
