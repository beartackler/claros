{
    "name": "Claros",
    "tags": [
        "claros",
        "hackathon"
    ],
    "conversation_config": {
        "agent": {
            "first_message": "",
            "language": "en",
            "dynamic_variables": {
                "dynamic_variable_placeholders": {
                    "mode": "capture",
                    "user_name": "there",
                    "workflow_name": "unknown workflow",
                    "session_id": "none",
                    "lang": "en",
                    "workflow_brief": "none yet"
                }
            },
            "prompt": {
                "prompt": "You are Claros, a warm, brief apprentice (with experts) and tutor (with learners) watching screen work.\nMode: {{mode}}. User: {{user_name}}. Workflow: {{workflow_name}}. Language: {{lang}}.\nWorkflow brief (the only rules you know):\n{{workflow_brief}}\n\nRules, in priority order:\n1. If the user message is ⟦say:ID|TEXT⟧ (or ⟦ask:ID|TEXT⟧ / ⟦intervene:ID|TEXT⟧): speak TEXT exactly, word for word, nothing before or after. Never read the ⟦⟧ marker, the ID or the \"|\".\n2. If the user is working, narrating, thinking aloud, reading the screen, talking to someone else, answering your question, confirming or correcting, or giving a command (off the record, strike that, not now, I'm done, stop, just watch, hint, what's next, walk me through, check my work, why): call skip_turn. The server handles it and will send ⟦say⟧. When unsure, call skip_turn.\n3. If the user asks Claros a general question (not covered by rule 2): answer in at most 2 short sentences using the brief, the latest \"Claros live context\" updates, or the claros_lookup tool if available. Never invent a rule, threshold, approver or number: if it is not there, say you'll ask the expert.\n4. Always answer in the user's language (call language_detection if it changes). No lists, no preamble.\n5. Call end_call only if the user clearly asks to hang up.",
                "llm": "gemini-3.6-flash",
                "reasoning_effort": "minimal",
                "temperature": 0.2,
                "max_tokens": 200,
                "tool_ids": [
                    "tool_5801m41whm6ge6bsfghjj8sqbysh",
                    "tool_6301m41whm6he4xve0vx3hyttqs7",
                    "tool_4801m41whm6jfeya9jdv11sfpe5p",
                    "tool_0401m41whm6kef7bj22dkdat9cdm",
                    "tool_5401m41whm6mepgt3jcvsr2ja1ff",
                    "tool_4101m41whm6nfx6b9ttskbk2pfv4",
                    "tool_9501m428smetfkprn93bm6r0b6pd"
                ],
                "built_in_tools": {
                    "skip_turn": {
                        "type": "system",
                        "name": "skip_turn",
                        "description": "Stay silent this turn. Use whenever the user is narrating their work, thinking aloud or not addressing Claros.",
                        "params": {
                            "system_tool_type": "skip_turn"
                        }
                    },
                    "language_detection": {
                        "type": "system",
                        "name": "language_detection",
                        "description": "",
                        "params": {
                            "system_tool_type": "language_detection",
                            "only_at_conversation_start": false
                        }
                    },
                    "end_call": {
                        "type": "system",
                        "name": "end_call",
                        "description": "End the session only when the user clearly says they are finished.",
                        "params": {
                            "system_tool_type": "end_call"
                        }
                    }
                },
                "ignore_default_personality": true,
                "enable_parallel_tool_calls": false,
                "backup_llm_config": {
                    "preference": "override",
                    "order": [
                        "glm-52",
                        "gemini-3.5-flash-lite"
                    ]
                },
                "cascade_timeout_seconds": 4,
                "custom_llm": null
            }
        },
        "language_presets": {
            "de": {
                "overrides": {
                    "agent": {
                        "language": "de"
                    }
                },
                "first_message_translation": null
            },
            "fr": {
                "overrides": {
                    "agent": {
                        "language": "fr"
                    }
                },
                "first_message_translation": null
            },
            "es": {
                "overrides": {
                    "agent": {
                        "language": "es"
                    }
                },
                "first_message_translation": null
            },
            "ru": {
                "overrides": {
                    "agent": {
                        "language": "ru"
                    }
                },
                "first_message_translation": null
            }
        },
        "tts": {
            "model_id": "eleven_v4_turbo",
            "voice_id": "XrExE9yKIg1WjnnlVkGX",
            "expressive_mode": true,
            "suggested_audio_tags": [
                {
                    "tag": "curious",
                    "description": "When asking the expert why."
                },
                {
                    "tag": "warm",
                    "description": "When encouraging a learner."
                }
            ],
            "stability": 0.5,
            "speed": 1.0,
            "similarity_boost": 0.8
        },
        "asr": {
            "provider": "scribe_realtime",
            "quality": "high",
            "keywords": [
                "Claros",
                "off the record",
                "strike that",
                "ERPNext",
                "invoice",
                "capex"
            ]
        },
        "turn": {
            "turn_eagerness": "patient",
            "turn_timeout": 30,
            "silence_end_call_timeout": -1,
            "soft_timeout_config": {
                "timeout_seconds": -1,
                "use_llm_generated_message": false
            }
        },
        "conversation": {
            "text_only": false,
            "max_duration_seconds": 3600
        }
    },
    "platform_settings": {
        "overrides": {
            "custom_llm_extra_body": true,
            "conversation_config_override": {
                "agent": {
                    "first_message": true,
                    "language": true,
                    "prompt": {
                        "prompt": true
                    }
                },
                "tts": {
                    "voice_id": true
                },
                "asr": {
                    "keywords": true
                }
            }
        },
        "privacy": {
            "record_voice": true,
            "retention_days": 7
        }
    }
}
