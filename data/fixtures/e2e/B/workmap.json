  "quotes": [
    {
      "id": "q_u_ebf68c72",
      "speaker": "Erika Expert",
      "speaker_id": "expert@ostwind.example",
      "lang": "en",
      "text": "Booked to small tools, that's wrong for a compressor.",
      "translations": {
        "de": "Auf kleine Werkzeuge gebucht, das ist für einen Kompressor falsch.",
        "fr": "Comptabilisé sur les petits outillages, c'est faux pour un compresseur.",
        "es": "Contabilizado en herramientas pequeñas, eso está mal para un compresor.",
        "ru": "Списано на мелкий инструмент — для компрессора это неверно."
      },
      "t": 1791096251507.0442,
      "session_id": "s_e7c397047833",
      "source": "live",
      "audio_clip": null
    },
    {
      "id": "q_u_b58bcf46",
      "speaker": "Erika Expert",
      "speaker_id": "expert@ostwind.example",
      "lang": "en",
      "text": "Equipment over 5,000 is always capex here, so it goes to Plants and Machineries and the Production cost center, never to small tools.",
      "translations": {
        "de": "Anlagen über 5.000 sind hier immer Investitionen, sie gehen daher auf Anlagen und Maschinen und die Kostenstelle Produktion, niemals auf kleine Werkzeuge.",
        "fr": "Tout équipement de plus de 5 000 est toujours une immobilisation ici, donc il va dans Installations et Machines et le centre de coûts Production, jamais dans les petits outillages.",
        "es": "El equipo de más de 5.000 es siempre capex aquí, así que va a Plantas y Maquinarias y al centro de costes de Producción, nunca a herramientas pequeñas.",
        "ru": "Оборудование свыше 5 000 здесь всегда относится к капвложениям, поэтому оно проводится по Основным средствам и машинам и центру затрат Производство, но никогда по мелкому инструменту."
      },
      "t": 1791096267517.081,
      "session_id": "s_e7c397047833",
      "source": "live",
      "audio_clip": null
    },
    {
      "id": "q_u_9cef689f",
      "speaker": "Erika Expert",
      "speaker_id": "expert@ostwind.example",
      "lang": "en",
      "text": "This supplier double-bills every December; hold it until they confirm. Same amount, just a suffix on the old invoice number.",
      "translations": {
        "de": "Dieser Lieferant stellt jede Doppelerstellung im Dezember; halten Sie ihn zurück, bis sie bestätigen. Gleicher Betrag, nur ein Suffix auf der alten Rechnungsnummer.",
        "fr": "Ce fournisseur double-facture chaque décembre ; bloquez-la jusqu'à leur confirmation. Même montant, juste un suffixe sur l'ancien numéro de facture.",
        "es": "Este proveedor factura doble cada diciembre; reténgala hasta que lo confirmen. El mismo importe, solo un sufijo en el número de factura antiguo.",
        "ru": "Этот поставщик каждый декабрь выставляет двойные счета; держите до их подтверждения. Та же сумма, просто суффикс к старому номеру счёта."
      },
      "t": 1791096313747.398,
      "session_id": "s_e7c397047833",
      "source": "live",
      "audio_clip": null
    },
    {
      "id": "q_u_a11aa628",
      "speaker": "Erika Expert",
      "speaker_id": "expert@ostwind.example",
      "lang": "en",
      "text": "Anything from the UK subsidiary needs a second approval from the controller before it is booked.",
      "translations": {
        "de": "Alles von der britischen Tochtergesellschaft benötigt eine zweite Freigabe durch den Controller, bevor es gebucht wird.",
        "fr": "Tout ce qui vient de la filiale britannique nécessite une deuxième validation du contrôleur avant comptabilisation.",
        "es": "Todo lo de la filial británica necesita una segunda aprobación del controller antes de contabilizarse.",
        "ru": "Всё от британского филиала требует второго подтверждения от контролёра до проведения учёта."
      },
      "t": 1791096358893.19,
      "session_id": "s_e7c397047833",
      "source": "live",
      "audio_clip": null
    },
    {
      "id": "q_s_e7c397047833_1",
      "speaker": "Erika Expert",
      "speaker_id": "expert@ostwind.example",
      "lang": "en",
      "text": "Any supplier: if the amount matches an invoice we already paid, put it on hold and ask the supplier. I release it myself once they confirm it's not a duplicate.",
