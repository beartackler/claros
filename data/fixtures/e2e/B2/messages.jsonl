{"dir": "s2c", "type": "say", "id": "teachback-21-6", "text": "If an invoice looks suspicious, I compare it against earlier invoices from the same supplier — Erika notes this supplier double-bills every December with the same amount.", "kind": "teachback", "lang": "en", "step_id": "s6", "_at": 1791096913623.685}
