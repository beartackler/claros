{"dir": "c2s", "at": 1791096984428.6443, "type": "utterance", "t_start": 1791096982627.372, "t_end": 1791096984428.5388, "role": "user", "text": "Yes, that's how I do it.", "lang": "en", "event_id": "u_326b8feb"}
